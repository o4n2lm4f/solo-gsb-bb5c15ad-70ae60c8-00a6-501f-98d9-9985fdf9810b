# Host port published by Docker Compose (container always listens on 8000)
HOST_PORT=8000
# Maximum accepted request body in bytes (default 10 MiB)
MAX_BODY_BYTES=10485760
# Default /commit proof format: "legacy" (per-leaf proofs) or "compact"
# (deduplicated multi-leaf proof); requests may still set "proofMode"
DEFAULT_PROOF_MODE=legacy
